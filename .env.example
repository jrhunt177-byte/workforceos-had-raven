# Copy to your deployment secret manager or local environment. Never commit real values.

# Required for Raven to generate chat replies (Anthropic Messages API key).
ANTHROPIC_API_KEY=

# Required. Postgres connection string (e.g. Replit's managed Postgres provides this
# automatically once attached — no manual setup needed on Replit).
DATABASE_URL=

# Optional. Defaults to 5000.
PORT=
